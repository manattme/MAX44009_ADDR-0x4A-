#include <Arduino.h>
#include <Wire.h>

#define MAX44009_ADDR 0x4A

uint8_t readRegister(uint8_t reg) {
  Wire.beginTransmission(MAX44009_ADDR);
  Wire.write(reg);
  Wire.endTransmission(false);
  Wire.requestFrom(MAX44009_ADDR, (uint8_t)1);
  if (Wire.available()) {
    return Wire.read();
  }
  return 0;
}

float readLux() {
  uint8_t highByte = readRegister(0x03); // Lux High Byte
  uint8_t lowByte  = readRegister(0x04); // Lux Low Byte

  uint8_t exponent = (highByte >> 4) & 0x0F;
  uint8_t mantissa = ((highByte & 0x0F) << 4) | (lowByte & 0x0F);

  float lux = pow(2, exponent) * mantissa * 0.045f;
  return lux;
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  Wire.begin(21, 22);

  Wire.beginTransmission(MAX44009_ADDR);
  if (Wire.endTransmission() == 0) {
    Serial.println("MAX44009 found");
  } else {
    Serial.println("MAX44009 not found");
    while (1) delay(1000);
  }
}

void loop() {
  float lux = readLux();

  Serial.print("Light: ");
  Serial.print(lux);
  Serial.println(" lx");

  delay(1000);
}
